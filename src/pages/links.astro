---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import friendLinks from "../data/friend-links.json";

type FriendLink = {
	avatar: string;
	nickname: string;
	homepageUrl: string;
	description: string;
};

const links = friendLinks as FriendLink[];

const getHost = (homepageUrl: string) => {
	try {
		return new URL(homepageUrl).hostname;
	} catch {
		return homepageUrl;
	}
};
---

<MainGridLayout title="友链" description="“告别这种事是有几分伤感，但你这么想，有告别才会有重逢。有重逢，便有了那杯装满故事的酒可敬了”">
	<div class="relative overflow-hidden rounded-[var(--radius-large)] border border-black/10 dark:border-white/10 bg-white/70 dark:bg-black/30 shadow-xl backdrop-blur-xl">
		<div class="relative z-10 px-5 md:px-8 py-6 md:py-8">
			<div class="flex items-start gap-4">
				<div class="mt-1 h-12 w-1.5 rounded-full bg-[var(--primary)]"></div>
				<div class="min-w-0">
					<h1 class="text-3xl md:text-4xl font-black tracking-tight text-black/90 dark:text-white/90">友链</h1>
					<p class="mt-2 text-sm md:text-base font-medium text-black/55 dark:text-white/55">
						“告别这种事是有几分伤感，但你这么想，有告别才会有重逢。有重逢，便有了那杯装满故事的酒可敬了”
					</p>
				</div>
			</div>

			<div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-5">
				{links.map((friend) => (
					<article class="group/card relative flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-black/10 dark:border-white/10 bg-white/60 dark:bg-black/25 p-4 md:p-5 shadow-lg backdrop-blur-xl transition">
						<div class="flex items-start gap-4">
							<div class="h-20 w-20 shrink-0 rounded-[1.2rem] bg-black/5 dark:bg-white/5 ring-1 ring-black/5 dark:ring-white/10 overflow-hidden">
								<img
									src={friend.avatar}
									alt={friend.nickname}
									class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-110"
									loading="lazy"
									decoding="async"
									referrerpolicy="no-referrer"
								/>
							</div>
							<div class="min-w-0 flex-1 pt-1">
								<h2 class="truncate text-2xl font-black tracking-tight text-black/90 dark:text-white/90 transition-colors duration-300 group-hover/card:text-[var(--primary)]">
									{friend.nickname}
								</h2>
								<div class="mt-1 text-sm font-medium text-black/45 dark:text-white/45">
									{getHost(friend.homepageUrl)}
								</div>
							</div>
						</div>

						<p class="mt-4 min-h-[3.25rem] flex-1 text-sm md:text-base leading-7 text-black/60 dark:text-white/65">
							{friend.description}
						</p>

						<div class="mt-5 flex items-center gap-2">
							<a
								href={friend.homepageUrl}
								target="_blank"
								rel="noopener"
								class="flex h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-[var(--primary)] px-4 font-bold text-white transition hover:brightness-105 active:scale-[0.99]"
							>
								<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.9rem]"></Icon>
								访问
							</a>
							<button
								type="button"
								class="group/copy flex h-11 w-11 items-center justify-center rounded-xl bg-black/8 text-black/55 transition hover:bg-black/12 hover:text-black/75 active:scale-95 dark:bg-white/10 dark:text-white/55 dark:hover:bg-white/15 dark:hover:text-white/80"
								data-copy-link={friend.homepageUrl}
								aria-label={`复制 ${friend.nickname} 的主页链接`}
								title="复制链接"
							>
								<Icon name="material-symbols:content-copy-rounded" class="text-[1.05rem]"></Icon>
							</button>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</MainGridLayout>

<script>
	const copyButtons = Array.from(document.querySelectorAll("[data-copy-link]"));

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const url = button.getAttribute("data-copy-link");
			if (!url || !navigator.clipboard) return;

			try {
				await navigator.clipboard.writeText(url);
				const previousColor = button.style.color;
				button.style.color = "var(--primary)";
				setTimeout(() => {
					button.style.color = previousColor;
				}, 1200);
			} catch {
				// ignore clipboard failures
			}
		});
	});
</script>
