---
const currentYear = new Date().getFullYear();
const birthDate = new Date("2003-11-21");
const now = new Date();

function getAge(currentDate: Date) {
    let age = currentDate.getFullYear() - birthDate.getFullYear();

    if (
        currentDate.getMonth() < birthDate.getMonth() ||
        (currentDate.getMonth() === birthDate.getMonth() &&
            currentDate.getDate() < birthDate.getDate())
    ) {
        age--;
    }

    return age;
}

const age = getAge(now);
const minutesLived = (now.getTime() - birthDate.getTime()) / 1000 / 60;
const breaths = Math.floor(minutesLived * 32);
---

<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>

<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span data-footer-copyright-year>{currentYear}</span> 局子粥头
        <br/>
        地球Online玩家｜Uptime <span data-footer-uptime-years>{age}</span> Years｜累计呼吸 <span data-footer-breath-text>{breaths.toLocaleString()}</span> 次｜
        <span class="inline-flex items-center">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1"></span>
            Online
        </span>
    </div>
</div>

<script>
    type StatsWindow = Window & {
        statsIntervalId?: number;
    };

    // 1. 定义统计数据计算逻辑
    function calculateStats() {
        const birthDate = new Date("2003-11-21");
        const now = new Date();

        let age = now.getFullYear() - birthDate.getFullYear();
        if (
            now.getMonth() < birthDate.getMonth() ||
            (now.getMonth() === birthDate.getMonth() &&
                now.getDate() < birthDate.getDate())
        ) {
            age--;
        }

        const minutesLived = (now.getTime() - birthDate.getTime()) / 1000 / 60;
        const breaths = Math.floor(minutesLived * 32);

        return {
            age: age.toString(),
            breathText: breaths.toLocaleString(),
        };
    }

    // 2. 更新页面中的所有统计节点
    function updateStats() {
        const { age, breathText } = calculateStats();

        /*
            这里不能继续使用 getElementById。
            页面会同时渲染桌面端和移动端两份 Footer，重复 id 只会命中第一份节点，
            导致另一份可见区域的数据不刷新，因此改为批量更新同类 data 标记节点。
        */
        document.querySelectorAll("[data-footer-uptime-years]").forEach(element => {
            element.textContent = age;
        });
        document.querySelectorAll("[data-footer-breath-text]").forEach(element => {
            element.textContent = breathText;
        });
    }

    // 3. 初始化并设置全局唯一的定时器
    updateStats();
    const statsWindow = window as StatsWindow;
    if (!statsWindow.statsIntervalId) {
        statsWindow.statsIntervalId = window.setInterval(updateStats, 1000);
    }
</script>
