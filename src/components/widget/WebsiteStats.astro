---
import { Icon } from "astro-icon/components";
import WidgetLayout from "./WidgetLayout.astro";
import { getPublishedPostCount } from "../../utils/content-utils";

type UmamiWebsiteStats = {
	pageviews?: number;
	visitors?: number;
	visits?: number;
};

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

const websiteId = import.meta.env.UMAMI_WEBSITE_ID;
const apiKey = import.meta.env.UMAMI_API_KEY;
const launchDate = new Date(2026, 4, 28);
const today = new Date();
const startOfToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());
const startOfLaunchDay = new Date(launchDate.getFullYear(), launchDate.getMonth(), launchDate.getDate());
const runningDays = Math.max(
	1,
	Math.floor((startOfToday.getTime() - startOfLaunchDay.getTime()) / 86400000) + 1,
);

const [postCount, umamiStats] = await Promise.all([
	getPublishedPostCount(),
	(async () => {
		try {
			if (!websiteId || !apiKey) {
				return null;
			}

			const response = await fetch(`https://api.umami.is/v1/websites/${websiteId}/stats`, {
				headers: {
					"x-umami-api-key": apiKey,
				},
			});

			if (!response.ok) {
				return null;
			}

			return (await response.json()) as UmamiWebsiteStats;
		} catch {
			return null;
		}
	})(),
]);

const numberFormatter = new Intl.NumberFormat("zh-CN");
const articleCount = numberFormatter.format(postCount);
const runningDaysText = numberFormatter.format(runningDays);
const pageviewsText = umamiStats?.pageviews != null ? numberFormatter.format(umamiStats.pageviews) : "--";
const visitsText = umamiStats?.visits != null ? numberFormatter.format(umamiStats.visits) : "--";
---

<WidgetLayout name="网站信息" id="website-stats" class={className} style={style}>
	<div class="grid grid-cols-2 gap-3 pb-1">
		<div class="rounded-xl bg-[var(--btn-regular-bg)] border border-black/5 dark:border-white/5 px-3 py-3 flex flex-col items-center text-center gap-1.5">
			<div class="flex items-center justify-center gap-1.5 text-black/45 dark:text-white/45 text-xs">
				<Icon name="material-symbols:description-outline-rounded" class="text-[1rem]"></Icon>
				<span>文章数</span>
			</div>
			<div class="w-full text-2xl font-bold leading-none text-black/85 dark:text-white/90 text-center">{articleCount}</div>
		</div>

		<div class="rounded-xl bg-[var(--btn-regular-bg)] border border-black/5 dark:border-white/5 px-3 py-3 flex flex-col items-center text-center gap-1.5">
			<div class="flex items-center justify-center gap-1.5 text-black/45 dark:text-white/45 text-xs">
				<Icon name="material-symbols:event-rounded" class="text-[1rem]"></Icon>
				<span>运行天数</span>
			</div>
			<div class="w-full text-2xl font-bold leading-none text-black/85 dark:text-white/90 text-center">{runningDaysText}</div>
		</div>

		<div class="rounded-xl bg-[var(--btn-regular-bg)] border border-black/5 dark:border-white/5 px-3 py-3 flex flex-col items-center text-center gap-1.5">
			<div class="flex items-center justify-center gap-1.5 text-black/45 dark:text-white/45 text-xs">
				<Icon name="material-symbols:visibility-outline-rounded" class="text-[1rem]"></Icon>
				<span>浏览量</span>
			</div>
			<div class="w-full text-2xl font-bold leading-none text-black/85 dark:text-white/90 text-center">{pageviewsText}</div>
		</div>

		<div class="rounded-xl bg-[var(--btn-regular-bg)] border border-black/5 dark:border-white/5 px-3 py-3 flex flex-col items-center text-center gap-1.5">
			<div class="flex items-center justify-center gap-1.5 text-black/45 dark:text-white/45 text-xs">
				<Icon name="material-symbols:person-outline-rounded" class="text-[1rem]"></Icon>
				<span>访问次数</span>
			</div>
			<div class="w-full text-2xl font-bold leading-none text-black/85 dark:text-white/90 text-center">{visitsText}</div>
		</div>
	</div>
</WidgetLayout>
