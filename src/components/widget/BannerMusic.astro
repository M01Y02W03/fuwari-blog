---
import { Icon } from "astro-icon/components";
import musicTracks from "../../data/banner-music.json";
import qishuiLogoRaw from "../../assets/svg/qishui-logo.svg?raw";

type BannerMusicTrack = {
	title: string;
	channel: string;
	url: string;
	author: string;
	cover?: string;
};

const PAGE_SIZE = 5;
const tracks = (musicTracks as BannerMusicTrack[]).map((track, index) => ({
	...track,
	page: Math.floor(index / PAGE_SIZE) + 1,
}));

const totalPages = Math.max(1, Math.ceil(tracks.length / PAGE_SIZE));
const visiblePageNumbers = totalPages <= 3
	? Array.from({ length: totalPages }, (_, index) => index + 1)
	: [1, 2, totalPages];
---

<div class="relative">
	<button
		id="banner-music-switch"
		aria-label="音乐信息"
		class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90"
		type="button"
	>
		<Icon name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
	</button>

	<div
		id="banner-music-panel"
		class="float-panel float-panel-closed fixed left-2 right-2 top-[4.75rem] z-50 w-auto max-h-[calc(100vh-5.5rem)] overflow-y-auto overscroll-contain px-3 py-3 sm:absolute sm:left-auto sm:right-0 sm:top-12 sm:w-[22rem] sm:max-w-[calc(100vw-2rem)] sm:px-4 sm:py-4"
		data-total-pages={totalPages}
	>
		<div class="flex items-center justify-between gap-3 mb-3">
			<div
				class="font-bold text-lg text-neutral-900 dark:text-neutral-100 transition relative ml-3 flex items-center gap-1.5
				before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
				before:absolute before:-left-3 before:top-[0.15rem]"
			>
				<div class="qishui-logo flex items-center justify-center h-5 w-auto" aria-hidden="true" role="img">
					<span set:html={qishuiLogoRaw}></span>
				</div>
			</div>
			<button
				id="music-view-toggle"
				class="btn-plain scale-animation rounded-lg h-8 w-8 flex items-center justify-center active:scale-90"
				aria-label="切换播放页"
				title="切换播放页"
			>
				<Icon name="material-symbols:swap-horiz-rounded" class="text-[1.5rem]" />
			</button>
		</div>

		<!-- List View -->
		<div id="music-list-view">
			<div class="space-y-1" data-music-tracks>
				{tracks.map((track, index) => (
						<div
							class="rounded-xl px-1 py-0.5 cursor-pointer hover:bg-black/5 dark:hover:bg-white/5 transition group"
							data-music-track
							data-music-page={track.page}
							data-track-index={index}
							data-music-url={track.url}
							data-music-cover={track.cover || ""}
							data-music-title={track.title}
							data-music-author={track.author}
						>
							<div
								class="flex items-center gap-1.5 sm:gap-2 text-xs md:text-[0.85rem] font-semibold leading-5 text-[var(--btn-content)] dark:text-[var(--btn-content)] group-hover:opacity-80 transition"
								title={track.title}
							>
								<Icon name="material-symbols:play-circle-rounded" class="shrink-0 text-[0.9rem] text-[var(--btn-content)]/80 dark:text-[var(--btn-content)]/80"></Icon>
								<span class="min-w-0 flex-1 truncate whitespace-nowrap">{track.title}</span>
								<span class="shrink-0 ml-auto whitespace-nowrap text-right text-[0.7rem] md:text-xs font-medium text-[var(--btn-content)]/80 dark:text-[var(--btn-content)]/80">
									@{track.author}
								</span>
							</div>
						</div>
					))}
			</div>

			<div class="mt-3 pt-3 border-t border-black/5 dark:border-white/5">
				<div class="flex items-center justify-center gap-2 flex-nowrap whitespace-nowrap overflow-x-auto hide-scrollbar">
				<button
					id="banner-music-prev"
					type="button"
					class="btn-plain scale-animation rounded-full h-8 px-3 text-sm font-bold active:scale-95 shrink-0"
				>
					上一页
				</button>
				{totalPages <= 3 ? (
					visiblePageNumbers.map((pageNumber) => (
						<button
							type="button"
							class:list={[
								"btn-plain scale-animation rounded-full h-8 min-w-8 px-2.5 text-sm font-bold active:scale-95 shrink-0",
								{ "bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]": pageNumber === 1 },
							]}
							data-music-page-btn={pageNumber}
						>
							{pageNumber}
						</button>
					))
				) : (
					<>
						<button
							type="button"
							class:list={[
								"btn-plain scale-animation rounded-full h-8 min-w-8 px-2.5 text-sm font-bold active:scale-95 shrink-0",
								{ "bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]": true },
							]}
							data-music-page-slot="first"
							data-music-page-btn="1"
						>
							1
						</button>
						<button
							type="button"
							class="btn-plain scale-animation rounded-full h-8 min-w-8 px-2.5 text-sm font-bold active:scale-95 shrink-0"
							data-music-page-slot="second"
							data-music-page-btn="2"
						>
							2
						</button>
						<button
							type="button"
							class="btn-plain scale-animation rounded-full h-8 min-w-8 px-2.5 text-sm font-bold active:scale-95 shrink-0 text-black/25 dark:text-white/25"
							data-music-ellipsis
							aria-label="下一页"
							title="下一页"
						>
							...
						</button>

						<button
							type="button"
							class="btn-plain scale-animation rounded-full h-8 min-w-8 px-2.5 text-sm font-bold active:scale-95 shrink-0"
							data-music-page-slot="last"
							data-music-page-btn={totalPages}
						>
							{totalPages}
						</button>
					</>
				)}
				<button
					id="banner-music-next"
					type="button"
					class="btn-plain scale-animation rounded-full h-8 px-3 text-sm font-bold active:scale-95 shrink-0"
				>
					下一页
				</button>
			</div>

			<div class="mt-2 text-center text-xs font-semibold text-black/45 dark:text-white/45" data-music-page-indicator>
				1 / {totalPages}
			</div>
		</div>
		</div>

		<!-- Player View -->
		<div id="music-player-view" class="hidden flex-col items-center pb-1">
			<div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden shadow-lg mb-3 bg-black/5 dark:bg-white/5 shrink-0 flex items-center justify-center group border-4 border-black/5 dark:border-white/5">
				<img id="music-player-cover" src="" alt="封面" class="w-full h-full object-cover animate-[spin_20s_linear_infinite] [animation-play-state:paused]" />
				<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-full flex items-center justify-center p-2 text-center backdrop-blur-[2px]">
					<span id="music-player-cover-author" class="text-white text-xs font-semibold truncate w-full px-2 drop-shadow-md">@歌手</span>
				</div>
			</div>
			<div class="text-center w-full px-4 mb-3 flex items-center justify-center gap-2 truncate">
				<h3 id="music-player-title" class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100 truncate" title="音乐标题">音乐标题</h3>
			</div>

			<!-- Audio Element -->
			<audio id="music-audio" src="" preload="metadata"></audio>

			<!-- Progress Bar -->
			<div class="w-full px-2 sm:px-4 mb-3">
				<div class="flex items-center gap-2 text-[0.65rem] sm:text-xs text-neutral-500 font-medium">
					<span id="music-time-current" class="w-8 text-right">0:00</span>
					<div class="flex-1 relative h-2 bg-black/10 dark:bg-white/10 rounded-full cursor-pointer group touch-none" id="music-progress-container">
						<div class="absolute -inset-y-3 -inset-x-1" id="music-progress-hitbox"></div>
						<div id="music-progress-bar" class="absolute left-0 top-0 bottom-0 bg-[var(--primary)] rounded-full w-0 transition-none"></div>
						<div id="music-progress-thumb" class="absolute top-1/2 -translate-y-1/2 -ml-2 w-4 h-4 bg-white border-2 border-[var(--primary)] rounded-full opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none left-0 shadow-sm"></div>
					</div>
					<span id="music-time-duration" class="w-8">0:00</span>
				</div>
			</div>

			<!-- Controls -->
			<div class="flex items-center justify-center gap-4 sm:gap-6 w-full mt-1">
				<button id="music-btn-prev" class="btn-plain scale-animation rounded-full h-8 w-8 flex items-center justify-center active:scale-90 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] dark:hover:text-[var(--primary)]" aria-label="上一首">
					<Icon name="material-symbols:skip-previous-rounded" class="text-2xl sm:text-3xl" />
				</button>
				<button id="music-btn-play" class="btn-plain scale-animation rounded-full h-10 w-10 flex items-center justify-center active:scale-90 text-[var(--primary)] hover:text-[var(--primary)]/80 transition-colors" aria-label="播放/暂停">
					<Icon id="music-icon-play" name="material-symbols:play-arrow-rounded" class="text-4xl sm:text-5xl" />
					<Icon id="music-icon-pause" name="material-symbols:pause-rounded" class="text-4xl sm:text-5xl hidden" />
				</button>
				<button id="music-btn-next" class="btn-plain scale-animation rounded-full h-8 w-8 flex items-center justify-center active:scale-90 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] dark:hover:text-[var(--primary)]" aria-label="下一首">
					<Icon name="material-symbols:skip-next-rounded" class="text-2xl sm:text-3xl" />
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	const trackNodes = Array.from(document.querySelectorAll("[data-music-track]"));
	const pageButtons = Array.from(document.querySelectorAll("[data-music-page-btn]"));
	const ellipsisBtn = document.querySelector("[data-music-ellipsis]");
	const indicator = document.querySelector("[data-music-page-indicator]");
	const prevBtn = document.getElementById("banner-music-prev");
	const nextBtn = document.getElementById("banner-music-next");
	const panel = document.getElementById("banner-music-panel");
	const switchBtn = document.getElementById("banner-music-switch");

	const viewToggleBtn = document.getElementById("music-view-toggle");
	const listView = document.getElementById("music-list-view");
	const playerView = document.getElementById("music-player-view");

	const audio = document.getElementById("music-audio") as HTMLAudioElement;
	const coverImg = document.getElementById("music-player-cover") as HTMLImageElement;
	const titleEl = document.getElementById("music-player-title");
	const coverAuthorEl = document.getElementById("music-player-cover-author");
	const timeCurrentEl = document.getElementById("music-time-current");
	const timeDurationEl = document.getElementById("music-time-duration");
	const progressContainer = document.getElementById("music-progress-container");
	const progressBar = document.getElementById("music-progress-bar");
	const progressThumb = document.getElementById("music-progress-thumb");

	const playBtn = document.getElementById("music-btn-play");
	const prevTrackBtn = document.getElementById("music-btn-prev");
	const nextTrackBtn = document.getElementById("music-btn-next");
	const iconPlay = document.getElementById("music-icon-play");
	const iconPause = document.getElementById("music-icon-pause");

	if (panel && switchBtn) {
		let currentPage = 1;
		let windowStart = 1;
		const totalPages = Number(panel.dataset.totalPages ?? "1") || 1;
		const maxWindowStart = Math.max(1, totalPages - 2);

		let currentTrackIndex = -1;
		let isPlayerView = false;
		let isDraggingProgress = false;

		const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

		const syncWindowForPage = (pageNumber: number) => {
			if (totalPages <= 3) {
				windowStart = 1;
				return;
			}
			windowStart = pageNumber <= 2 ? 1 : pageNumber >= totalPages - 1 ? maxWindowStart : clamp(pageNumber - 1, 1, maxWindowStart);
		};

		const renderPagination = () => {
			trackNodes.forEach((track) => {
				const pageNumber = Number(track.getAttribute("data-music-page") ?? "1");
				track.classList.toggle("hidden", pageNumber !== currentPage);
			});

			if (totalPages > 3 && pageButtons.length >= 3) {
				const [firstButton, secondButton, lastButton] = pageButtons;
				const updateBtn = (btn: Element, page: number) => {
					btn.setAttribute("data-music-page-btn", String(page));
					btn.textContent = String(page);
					btn.classList.toggle("bg-[var(--btn-plain-bg-hover)]", currentPage === page);
					btn.classList.toggle("shadow-sm", currentPage === page);
					btn.classList.toggle("text-[var(--primary)]", currentPage === page);
				};
				updateBtn(firstButton, windowStart);
				updateBtn(secondButton, windowStart + 1);
				updateBtn(lastButton, totalPages);
			}

			if (indicator) {
				indicator.textContent = `${currentPage} / ${totalPages}`;
			}

			pageButtons.forEach((button) => {
				const pageNumber = Number(button.getAttribute("data-music-page-btn") ?? "1");
				button.classList.toggle("bg-[var(--btn-plain-bg-hover)]", pageNumber === currentPage);
				button.classList.toggle("shadow-sm", pageNumber === currentPage);
				button.classList.toggle("text-[var(--primary)]", pageNumber === currentPage);
			});

			if (prevBtn) {
				prevBtn.toggleAttribute("disabled", currentPage <= 1);
				prevBtn.classList.toggle("opacity-40", currentPage <= 1);
				prevBtn.classList.toggle("pointer-events-none", currentPage <= 1);
			}

			if (nextBtn) {
				nextBtn.toggleAttribute("disabled", currentPage >= totalPages);
				nextBtn.classList.toggle("opacity-40", currentPage >= totalPages);
				nextBtn.classList.toggle("pointer-events-none", currentPage >= totalPages);
			}
		};

		// 1. 格式化时间
		const formatTime = (seconds: number) => {
			if (isNaN(seconds)) return "0:00";
			const mins = Math.floor(seconds / 60);
			const secs = Math.floor(seconds % 60);
			return `${mins}:${secs.toString().padStart(2, "0")}`;
		};

		// 2. 加载音乐轨道
		const loadTrack = (index: number) => {
			if (index < 0 || index >= trackNodes.length) return;
			currentTrackIndex = index;
			const trackNode = trackNodes[index];
			
			const title = trackNode.getAttribute("data-music-title") || "未知标题";
			const author = trackNode.getAttribute("data-music-author") || "未知歌手";
			const cover = trackNode.getAttribute("data-music-cover") || "";
			const url = trackNode.getAttribute("data-music-url") || "";

			if (titleEl) titleEl.textContent = title;
			if (coverAuthorEl) coverAuthorEl.textContent = `@${author}`;
			
			if (coverImg) {
				coverImg.src = cover;
				coverImg.style.display = cover ? "block" : "none";
			}
			
			if (audio.src !== url) {
				audio.src = url;
				audio.load();
			}
			
			// 3. 在列表中高亮当前播放的音乐
			trackNodes.forEach((node, i) => {
				node.classList.toggle("bg-black/5", i === index);
				node.classList.toggle("dark:bg-white/5", i === index);
				const icon = node.querySelector("svg");
				if (icon) {
					icon.classList.toggle("text-[var(--primary)]", i === index);
					icon.classList.toggle("dark:text-[var(--primary)]", i === index);
				}
			});
		};

		const togglePlay = () => {
			if (currentTrackIndex === -1 && trackNodes.length > 0) {
				loadTrack(0);
			}
			
			if (!audio.src) return;
			
			if (audio.paused) {
				audio.play().catch(e => console.error("Playback failed:", e));
			} else {
				audio.pause();
			}
		};

		const updatePlayState = () => {
			if (!iconPlay || !iconPause) return;
			if (audio.paused) {
				iconPlay.classList.remove("hidden");
				iconPause.classList.add("hidden");
				if (coverImg) coverImg.style.animationPlayState = "paused";
			} else {
				iconPlay.classList.add("hidden");
				iconPause.classList.remove("hidden");
				if (coverImg) coverImg.style.animationPlayState = "running";
			}
		};

		const playNext = () => {
			let nextIndex = currentTrackIndex + 1;
			if (nextIndex >= trackNodes.length) nextIndex = 0;
			loadTrack(nextIndex);
			audio.play().catch(e => console.error(e));
		};

		const playPrev = () => {
			let prevIndex = currentTrackIndex - 1;
			if (prevIndex < 0) prevIndex = trackNodes.length - 1;
			loadTrack(prevIndex);
			audio.play().catch(e => console.error(e));
		};

		// 4. 切换视图（列表或播放器）
		const toggleView = (forcePlayer?: boolean) => {
			isPlayerView = forcePlayer !== undefined ? forcePlayer : !isPlayerView;
			if (listView && playerView) {
				listView.classList.toggle("hidden", isPlayerView);
				playerView.classList.toggle("hidden", !isPlayerView);
				playerView.classList.toggle("flex", isPlayerView);
			}
		};

		// 5. 事件监听绑定
		viewToggleBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			toggleView();
		});

		trackNodes.forEach((track, index) => {
			track.addEventListener("click", (e) => {
				e.stopPropagation();
				if (currentTrackIndex !== index) {
					loadTrack(index);
					audio.play().catch(err => console.error(err));
				}
				toggleView(true);
			});
		});

		playBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			togglePlay();
		});

		prevTrackBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			playPrev();
		});

		nextTrackBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			playNext();
		});

		audio.addEventListener("play", updatePlayState);
		audio.addEventListener("pause", updatePlayState);
		audio.addEventListener("ended", playNext);

		audio.addEventListener("timeupdate", () => {
			if (!isDraggingProgress && audio.duration) {
				const progress = (audio.currentTime / audio.duration) * 100;
				if (progressBar) progressBar.style.width = `${progress}%`;
				if (progressThumb) progressThumb.style.left = `${progress}%`;
				if (timeCurrentEl) timeCurrentEl.textContent = formatTime(audio.currentTime);
			}
		});

		audio.addEventListener("loadedmetadata", () => {
			if (timeDurationEl) timeDurationEl.textContent = formatTime(audio.duration);
		});

		// 6. 进度条拖动逻辑
		if (progressContainer) {
			const updateProgress = (clientX: number) => {
				const rect = progressContainer.getBoundingClientRect();
				const pos = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
				if (progressBar) progressBar.style.width = `${pos * 100}%`;
				if (progressThumb) progressThumb.style.left = `${pos * 100}%`;
				return pos;
			};

			const startDragging = (clientX: number) => {
				isDraggingProgress = true;
				updateProgress(clientX);
			};

			const stopDragging = (clientX: number) => {
				if (isDraggingProgress) {
					isDraggingProgress = false;
					if (audio.duration) {
						const pos = updateProgress(clientX);
						audio.currentTime = pos * audio.duration;
					}
				}
			};

			// Mouse Events
			progressContainer.addEventListener("mousedown", (e) => startDragging(e.clientX));
			document.addEventListener("mousemove", (e) => {
				if (isDraggingProgress) updateProgress(e.clientX);
			});
			document.addEventListener("mouseup", (e) => stopDragging(e.clientX));

			// Touch Events
			progressContainer.addEventListener("touchstart", (e) => {
				e.preventDefault(); // Prevent scrolling while dragging
				startDragging(e.touches[0].clientX);
			}, { passive: false });
			
			document.addEventListener("touchmove", (e) => {
				if (isDraggingProgress) {
					e.preventDefault();
					updateProgress(e.touches[0].clientX);
				}
			}, { passive: false });
			
			document.addEventListener("touchend", (e) => {
				if (isDraggingProgress) {
					stopDragging(e.changedTouches[0].clientX);
				}
			});
		}

		// 7. 分页事件
		prevBtn?.addEventListener("click", (event) => {
			event.stopPropagation();
			if (currentPage <= 1) return;
			currentPage -= 1;
			syncWindowForPage(currentPage);
			renderPagination();
		});

		nextBtn?.addEventListener("click", (event) => {
			event.stopPropagation();
			if (currentPage >= totalPages) return;
			currentPage += 1;
			syncWindowForPage(currentPage);
			renderPagination();
		});

		pageButtons.forEach((button) => {
			button.addEventListener("click", (event) => {
				event.stopPropagation();
				const pageNumber = Number(button.getAttribute("data-music-page-btn") ?? "1");
				if (!Number.isNaN(pageNumber)) {
					currentPage = pageNumber;
					syncWindowForPage(pageNumber);
					renderPagination();
				}
			});
		});

		ellipsisBtn?.addEventListener("click", (event) => {
			event.stopPropagation();
			if (totalPages <= 3 || windowStart >= maxWindowStart) return;
			windowStart = Math.min(windowStart + 1, maxWindowStart);
			currentPage = windowStart;
			renderPagination();
		});

		switchBtn.addEventListener("click", (event) => {
			event.stopPropagation();
			panel.classList.toggle("float-panel-closed");
			renderPagination();
		});

		// 8. 初始化
		renderPagination();
		if (trackNodes.length > 0) {
			loadTrack(0);
		}
	}
</script>

<style>
	.qishui-logo {
		color: var(--btn-content);
	}

	.qishui-logo :global(svg) {
		display: block;
		height: 1.25rem;
		width: auto;
	}

	.qishui-logo :global(path[fill="white"]) {
		fill: currentColor;
	}
</style>
